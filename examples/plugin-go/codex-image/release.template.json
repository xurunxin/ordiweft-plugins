        "id": "gen",
        "label": "图片生成（订阅）",
        "capability": "image.generate",
        "model": "gpt-image-2"
      }
    ],
    "scheduling": {
      "independent": true,
      "concurrency": 1,
      "maxQueued": 20,
      "cancelable": false
