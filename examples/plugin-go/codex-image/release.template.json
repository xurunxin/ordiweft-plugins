    "models": [
      {
        "id": "gpt-image-2",
        "label": "Images 2.6 · 订阅自动路由",
        "capability": "image.generate",
        "inputKinds": [
          "image"
        ],
        "maxInputs": 5,
        "fields": {
          "ratio": {
            "type": "string",
            "label": "画面比例",
            "enum": [
              "auto",
              "1:1",
              "2:1",
              "4:3",
              "3:4",
              "5:4",
              "4:5",
              "3:2",
              "2:3",
              "360",
              "16:9",
              "9:16",
              "21:9",
              "9:21"
            ],
            "default": "auto",
            "description": "通过提示词约束构图比例，不指定输出像素；实际尺寸以上游返回为准。"
          },
          "style": {
            "type": "string",
            "label": "风格",
            "default": "",
            "control": "style"
          },
          "background": {
            "type": "string",
            "label": "背景",
            "enum": [
              "auto",
              "opaque",
              "transparent"
            ],
            "default": "auto",
            "optionLabels": {
              "auto": "自动",
              "opaque": "不透明",
              "transparent": "透明"
            }
          }
        },
        "prompt": {
          "label": "图片描述",
          "required": true,
          "maxLength": 20000
        }
