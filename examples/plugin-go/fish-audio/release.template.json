        },
        "label": "Drama 3 · 导演式多角色语音",
        "capability": "speech.generate",
        "maxVoices": 16,
        "inputKinds": [
          "audio"
        ],
        "maxInputs": 1,
        "outputKinds": [
          "audio"
        ],
        "prompt": {
          "label": "台词 / 多角色剧本",
          "required": true,
          "maxLength": 20000,
          "placeholder": "<|speaker:0|>[温柔地安慰] 别担心，<whisper>我在这里。</whisper>\n<|speaker:1|>[松了一口气] 谢谢你。[pause] 我好多了。"
        },
        "inputRoles": {
          "speaker": {
            "kind": "audio",
            "label": "零样本克隆参考音频",
            "description": "连接录音或已选中的声音设计候选；不能同时连接音色 ID。"
          }
        },
        "fields": {
          "voice_id": {
            "type": "string",
            "label": "音色 ID",
            "control": "voice",
            "maxLength": 128,
            "description": "未连音色时使用。多个说话人可在下方填写有序音色列表；连接音色将覆盖这些草稿。"
          },
          "speakers": {
            "type": "array",
            "label": "多说话人音色（从 0 开始）",
            "default": [],
            "description": "每行一个音色 ID，最多 16 个；顺序对应台词中的 <|speaker:N|>。有音色连线时以连线顺序为准。",
            "items": {
              "type": "string",
              "label": "音色 ID",
              "maxLength": 128
            }
          },
          "reference_text": {
            "type": "string",
            "label": "参考录音原文",
            "control": "textarea",
            "maxLength": 10000,
            "description": "只用于 audio-in 零样本克隆，是录音中已经说过的内容；不是待合成台词。推荐 10–30 秒清晰单人录音。"
          },
          "format": {
            "type": "string",
            "label": "文件格式",
            "default": "mp3",
            "enum": [
              "mp3",
              "wav"
            ]
          },
          "speed": {
            "type": "number",
            "label": "语速",
            "default": 1,
            "minimum": 0.5,
            "maximum": 2,
            "step": 0.05
          },
          "volume": {
            "type": "number",
            "label": "音量（dB）",
            "default": 0,
            "minimum": -20,
            "maximum": 20
          },
          "normalize": {
            "type": "boolean",
            "label": "文本规范化",
            "default": true
          },
          "temperature": {
            "type": "number",
            "label": "表达变化",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "step": 0.05,
            "section": "advanced"
          },
          "top_p": {
            "type": "number",
            "label": "采样多样性",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "step": 0.05,
            "section": "advanced"
          },
          "chunk_length": {
            "type": "integer",
            "label": "文本分块长度",
            "default": 300,
            "minimum": 100,
            "maximum": 300,
            "section": "advanced"
          },
          "latency": {
            "type": "string",
            "label": "延迟模式",
            "default": "normal",
