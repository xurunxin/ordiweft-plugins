        "volume":{"type":"number","label":"音量","control":"slider","default":1,"minimum":0.01,"maximum":2,"step":0.05},
        "use_speaker_boost":{"type":"boolean","label":"增强音色相似度","default":false,"description":"无指导文本时会将引导强度按 1 处理；有指导文本且强度大于 1 时上游忽略此开关。"}
      }},
    {"id":"breeze-voice-design","label":"文字设计并保存在线音色","capability":"voice.design","inputKinds":[],"maxInputs":0,
