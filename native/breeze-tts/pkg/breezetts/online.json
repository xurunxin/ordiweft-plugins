      "fields":{
        "voice_name":{"type":"string","label":"保存音色名称","required":true,"maxLength":80},
        "language_code":{"type":"string","label":"音色语言","default":"zh","enum":["zh","en"],"optionLabels":{"zh":"中文","en":"英语"},"icon":"language"},
        "preview_text":{"type":"string","label":"试听文本","control":"textarea","placement":"body","default":"欢迎来到织序，让创意拥有声音。","maxLength":500},
        "guidance_scale":{"type":"number","label":"指令引导强度","control":"slider","default":4,"minimum":1,"maximum":10,"step":0.5}
      }},
    {"id":"breeze-voice-clone","label":"参考音频克隆并保存在线音色","capability":"voice.design","inputKinds":["audio"],"maxInputs":1,
      "inputRoles":{"speaker":{"label":"授权音色参考","kind":"audio","required":true,"description":"上传 3–30 秒 PCM WAV，最多 5 MB。只使用有权克隆的声音；在线服务自动转写，无需逐字稿。"}},
      "prompt":{"label":"音色备注","required":true,"maxLength":500,"placeholder":"描述此音色的来源与用途；在线服务会生成试听文本并保存音色。"},
      "fields":{
        "voice_name":{"type":"string","label":"保存音色名称","required":true,"maxLength":80},
        "language_code":{"type":"string","label":"参考音频语言","default":"zh","enum":["zh","en"],"optionLabels":{"zh":"中文","en":"英语"},"icon":"language"},
