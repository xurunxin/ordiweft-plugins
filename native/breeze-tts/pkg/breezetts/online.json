  "nodes":[{"id":"speech","label":"语音合成（Breeze 在线）","capability":"speech.generate","model":"breeze-tts-2"},{"id":"voice","label":"音色设计与克隆（Breeze 在线）","capability":"voice.design","model":"breeze-voice-design"}],
  "models":[
    {"id":"breeze-tts-2","label":"Breeze TTS 2（在线，中英双语）","capability":"speech.generate","inputKinds":[],"maxInputs":0,"maxVoices":1,
      "prompt":{"label":"合成文本","required":true,"maxLength":1000,"placeholder":"支持中文 [笑]、[叹气]，英文 (laugh)、(sigh)。可连接本渠道设计或克隆的音色。"},
      "fields":{
        "voice_id":{"type":"string","label":"在线音色","control":"voice","default":"","maxLength":128,"description":"浏览官方音色库并试听，或填写已有 voice_id；连接本渠道音色节点时可留空。"},
        "instructions":{"type":"string","label":"表演指导","control":"textarea","placement":"body","default":"","maxLength":1000,"description":"与正文使用相同语言，描述情绪、节奏与表达；保留所选音色身份。"},
        "language_code":{"type":"string","label":"语言","default":"zh","enum":["zh","en"],"optionLabels":{"zh":"中文","en":"英语"},"icon":"language"},
        "guidance_scale":{"type":"number","label":"指令引导强度","control":"slider","default":4,"minimum":1,"maximum":10,"step":0.5},
