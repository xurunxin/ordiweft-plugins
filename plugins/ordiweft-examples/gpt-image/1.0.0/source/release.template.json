            "order": 16
          },
          "mask": {
            "kind": "image",
            "label": "编辑遮罩",
            "description": "与第一张参考图同尺寸的透明 PNG，小于 4 MB；透明区域为编辑区域。",
            "required": true,
            "order": 17,
            "visibleWhen": {
              "edit_overlay": "mask"
            }
          }
        },
        "prompt": {
          "label": "提示词",
          "placeholder": "描述图像；连接参考图进行编辑，可选遮罩控制局部修改。",
          "required": true,
          "maxLength": 32000
        },
        "id": "gpt-image-1.5",
        "label": "gpt-image-1.5",
        "capability": "image.generate",
        "inputKinds": [
          "image"
        ],
        "maxInputs": 17,
        "fields": {
          "background": {
            "optionLabels": {
              "auto": "自动",
              "opaque": "不透明",
              "transparent": "透明"
            },
            "visibleWhenAny": [
              {
                "output_format": "png"
              },
              {
                "output_format": "webp"
              }
            ],
            "type": "string",
            "label": "背景",
            "default": "auto",
            "enum": [
              "auto",
              "opaque",
              "transparent"
            ]
          },
          "edit_overlay": {
            "optionLabels": {
              "mask": "遮罩",
              "none": "无"
            },
            "type": "string",
            "label": "局部编辑",
            "default": "none",
            "enum": [
              "none",
              "mask"
            ]
          },
          "input_fidelity": {
            "optionLabels": {
              "high": "高",
              "low": "低"
            },
            "type": "string",
            "label": "参考保真度",
            "default": "low",
            "enum": [
              "low",
              "high"
            ]
          },
          "moderation": {
            "optionLabels": {
              "auto": "自动",
              "low": "宽松"
            },
            "type": "string",
            "label": "内容审核",
            "default": "auto",
            "enum": [
              "auto",
              "low"
            ]
          },
          "n": {
            "visibleWhen": {
              "stream": false
            },
            "type": "integer",
            "label": "生成数量",
            "control": "count",
            "default": 1,
            "minimum": 1,
            "maximum": 10
          },
          "output_compression": {
            "section": "advanced",
            "visibleWhenAny": [
              {
                "output_format": "jpeg"
              },
              {
                "output_format": "webp"
              }
            ],
            "type": "integer",
            "label": "压缩质量",
            "default": 100,
            "minimum": 0,
            "maximum": 100
          },
          "output_format": {
            "optionLabels": {
              "jpeg": "JPEG",
              "png": "PNG",
              "webp": "WebP"
            },
            "type": "string",
            "label": "输出格式",
            "default": "png",
            "enum": [
              "png",
              "jpeg",
              "webp"
            ]
          },
          "partial_images": {
            "section": "advanced",
            "visibleWhen": {
              "stream": true
            },
            "type": "integer",
            "label": "中间图数量",
            "default": 0,
            "minimum": 0,
            "maximum": 3
          },
          "quality": {
            "optionLabels": {
              "auto": "自动",
              "high": "高",
              "low": "低",
              "medium": "中"
            },
            "type": "string",
            "label": "质量",
            "default": "auto",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ]
          },
          "safety_identifier": {
            "section": "advanced",
            "description": "可选的匿名用户标识；留空时由宿主身份生成哈希。",
            "maxLength": 128,
            "type": "string",
            "label": "安全标识"
          },
          "size": {
            "optionLabels": {
              "1024x1024": "方形 1:1",
              "1024x1536": "纵向 2:3",
              "1536x1024": "横向 3:2",
              "1536x864": "横向 16:9",
              "2048x2048": "2K 方形",
              "2160x3840": "4K 纵向",
              "3840x2160": "4K 横向",
              "864x1536": "纵向 9:16",
              "auto": "自动"
            },
            "description": "此模型仅支持自动、1024x1024、1024x1536 和 1536x1024。",
            "maxLength": 32,
            "type": "string",
            "label": "分辨率",
            "control": "resolution",
            "default": "1024x1024",
            "enum": [
              "auto",
              "1024x1024",
              "1024x1536",
              "1536x1024"
            ]
          },
          "stream": {
            "section": "advanced",
            "description": "仅支持单张。接收中间图事件；仅最终图保存为版本，中断不重新提交。",
            "type": "boolean",
            "label": "流式接收",
            "default": false
          },
          "user": {
            "section": "advanced",
            "description": "兼容官方弃用参数；优先使用安全标识。",
            "maxLength": 128,
            "type": "string",
            "label": "旧版用户标识"
          }
        }
      }
    ],
    "scheduling": {
      "independent": true,
      "concurrency": 64,
      "maxQueued": 20,
      "cancelable": false
    }
  },
  "files": []
