    "prompt": {
      "$host": "prompt",
      "suffixes": [
        {
          "text": "\n\nRender this scene as a full-sphere 360 by 180 degree equirectangular environment panorama. Use a single fixed camera position and a 2:1 latitude-longitude projection, with the horizon level at the vertical midpoint, zenith at the top and nadir at the bottom. The left and right borders must meet seamlessly with continuous objects, lighting and perspective. Include the entire surrounding scene, sky and ground. Do not render a flat wide-angle photograph, fisheye, tiny planet, collage, frame, labels or projection diagram.",
          "whenAny": [
            {
              "/model": [
                "gpt-image-2.6-flare",
                "gpt-image-2.6-sunburst",
                "gpt-image-2.5-flare",
                "gpt-image-2.5-sunburst",
                "gpt-image-2",
                "gpt-image-2.5-flare-2026-09-08",
                "gpt-image-2.5-sunburst-2026-09-08",
                "gpt-image-2-2026-04-21"
              ],
              "/parameters/aspect_ratio": [
                "360"
              ],
              "/parameters/custom_resolution": [
                false
              ]
            }
          ]
        }
      ]
    },
    "quality": {
      "$host": "parameter",
      "name": "quality"
    },
    "safety_identifier": {
      "$host": "first-text",
      "fallback": "actor-hash",
      "parameters": [
        "safety_identifier",
        "user"
      ]
    },
