{
  "version": 1,
  "id": "document-text",
  "kind": "processor",
  "action": {
    "label": "结构文档转文本",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "maxLength": 256},
        "paragraphs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 2000}}
      },
      "required": ["title", "paragraphs"],
      "additionalProperties": false
    },
    "resultSchema": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "maxLength": 65536},
        "paragraphCount": {"type": "integer", "minimum": 1, "maximum": 64},
        "characters": {"type": "integer", "minimum": 0, "maximum": 65536}
      },
      "required": ["text", "paragraphCount", "characters"],
      "additionalProperties": false
    },
    "resources": {"maxInputs": 0, "maxOutputs": 0, "maxInputBytes": 0, "maxOutputBytes": 65536, "maxRuntimeMs": 60000}
  }
}
