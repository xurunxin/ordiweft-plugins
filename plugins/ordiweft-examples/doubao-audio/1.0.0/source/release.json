    "nodes": [
      {
        "id": "audio",
        "label": "SeedAudio 音频生成",
        "capability": "music.generate",
        "model": "seed-audio-1.0"
      }
    ],
    "models": [
      {
        "outputKinds": [
          "audio"
        ],
        "prompt": {
          "label": "音频创作描述",
          "placeholder": "用自然语言描述对白、语气、背景音乐、音效与环境音，也可指定时间轴与总时长（最长 120 秒）。",
          "required": true,
          "maxLength": 3000
        },
        "id": "seed-audio-1.0",
        "label": "SeedAudio 1.0 · 全要素音频",
        "capability": "music.generate",
        "inputKinds": [],
        "maxInputs": 0,
        "fields": {
          "aigc_watermark": {
            "section": "advanced",
            "type": "boolean",
            "label": "结尾声音标识",
            "default": false
          },
          "format": {
            "type": "string",
            "label": "文件格式",
            "default": "mp3",
            "enum": [
              "mp3",
              "wav"
            ]
          },
          "loudness_rate": {
            "type": "integer",
            "label": "音量（0 正常）",
            "default": 0,
            "minimum": -50,
            "maximum": 100
          },
          "metadata_watermark": {
            "section": "advanced",
            "type": "boolean",
            "label": "文件元数据标识",
            "default": true
          },
          "pitch_rate": {
            "type": "integer",
            "label": "音调",
            "default": 0,
            "minimum": -12,
            "maximum": 12
          },
          "sample_rate": {
            "type": "integer",
            "label": "采样率",
            "default": 48000,
            "enum": [
              8000,
              16000,
              24000,
              32000,
              44100,
              48000
            ]
          },
          "speech_rate": {
            "type": "integer",
            "label": "语速（0 正常）",
            "default": 0,
            "minimum": -50,
            "maximum": 100
          }
        }
      }
    ]
