{
  "version": 1,
  "id": "media-inspection",
  "kind": "processor",
  "action": {
    "label": "素材字节检查",
    "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false},
    "resultSchema": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["image", "audio"]},
        "mime": {"type": "string", "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "durationMs": {"type": "integer", "minimum": 0},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{2,16}$"}
      },
      "required": ["kind", "mime", "sha256", "bytes", "width", "height", "durationMs", "signature"],
      "additionalProperties": false
    },
    "resources": {"maxInputs": 1, "maxOutputs": 0, "maxInputBytes": 67108864, "maxOutputBytes": 65536, "maxRuntimeMs": 60000}
  }
}
